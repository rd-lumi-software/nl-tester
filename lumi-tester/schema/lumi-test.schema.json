{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nlt-corp.github.io/lumi-tester/schema/lumi-test.schema.json",
  "title": "Lumi Tester Flow",
  "description": "Schema for Lumi Tester YAML flows. Command names are kept in sync with src/parser/yaml.rs; command parameters are intentionally permissive for forward compatibility.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "appId": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "android",
        "android_auto",
        "ios",
        "iOS",
        "web",
        "macos",
        "macOS",
        "windows"
        ,"lumi_e2e"
        ,"lumi_hc"
        ,"lumi_cloud"
      ]
    },
    "app": {
      "$ref": "#/$defs/component"
    },
    "gateway": {
      "$ref": "#/$defs/component"
    },
    "cloud": {
      "$ref": "#/$defs/component"
    },
    "profile": {
      "type": "string"
    },
    "journey": {
      "type": "string",
      "deprecated": true,
      "description": "Legacy metadata only; target adapters are selected by app/gateway/cloud components."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "defaultTimeout": {
      "type": "integer",
      "minimum": 0
    },
    "speed": {
      "type": "string",
      "enum": [
        "turbo",
        "fast",
        "normal",
        "safe"
      ]
    },
    "browser": {
      "type": "string",
      "enum": [
        "Chrome",
        "Firefox",
        "Webkit",
        "chrome",
        "firefox",
        "webkit",
        "chromium"
      ]
    },
    "closeWhenFinish": {
      "type": "boolean"
    },
    "desktopState": {
      "$ref": "#/$defs/desktopState"
    },
    "env": {
      "$ref": "#/$defs/env"
    },
    "vars": {
      "$ref": "#/$defs/envMap"
    },
    "camera": {
      "$ref": "#/$defs/cameraConfig"
    },
    "cameras": {
      "$ref": "#/$defs/camerasConfig"
    },
    "jig": {
      "$ref": "#/$defs/jigConfig"
    },
    "data": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/command"
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "steps"
      ]
    },
    {
      "required": [
        "commands"
      ]
    }
  ],
  "$defs": {
    "component": {
      "type": "object",
      "required": ["platform"],
      "additionalProperties": true,
      "properties": {
        "platform": { "type": "string" },
        "appId": { "type": "string" },
        "profile": { "type": "string" },
        "capabilities": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "runFlow": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "path": { "type": "string" },
        "target": {
          "type": "string",
          "enum": ["app", "gateway", "cloud"]
        },
        "commands": { "$ref": "#/$defs/commandArray" },
        "vars": { "$ref": "#/$defs/envMap" },
        "optional": { "type": "boolean" }
      }
    },
    "env": {
      "oneOf": [
        {
          "$ref": "#/$defs/envMap"
        },
        {
          "type": "object",
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "envMap": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "cameraConfig": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "rtsp": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "transport": {
          "type": "string",
          "enum": [
            "tcp",
            "udp",
            "TCP",
            "UDP"
          ]
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "camerasConfig": {
      "oneOf": [
        {
          "$ref": "#/$defs/cameraConfig"
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/cameraConfig"
          }
        }
      ]
    },
    "jigConfig": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "port": {
              "type": "string"
            },
            "baudrate": {
              "type": "integer"
            },
            "autoPowerOff": {
              "type": "boolean"
            },
            "timeoutMs": {
              "type": "integer"
            },
            "file": {
              "type": "string"
            },
            "servos": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/servoConfig"
              }
            },
            "buttons": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/buttonConfig"
              }
            },
            "relays": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              }
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "buttonConfig": {
      "type": "object",
      "properties": {
        "servo": {
          "type": "integer"
        },
        "sensor": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "servoConfig": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "integer"
        },
        "pressAngle": {
          "type": "integer"
        },
        "releaseAngle": {
          "type": "integer"
        },
        "pressDurationMs": {
          "type": "integer"
        },
        "releaseDurationMs": {
          "type": "integer"
        },
        "holdDurationMs": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "desktopState": {
      "type": "object",
      "properties": {
        "clear": {
          "$ref": "#/$defs/desktopClear"
        }
      },
      "additionalProperties": true
    },
    "desktopClear": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "autoSafe",
            "manual"
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "keychainServices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "registryKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "commandName": {
      "type": "string",
      "enum": [
        "airplaneMode",
        "assert",
        "assertClipboard",
        "assertColor",
        "assertDeviceChange",
        "assertDevicePattern",
        "assertDeviceState",
        "assertDeviceTransition",
        "assertNotVisible",
        "assertPerformance",
        "assertScreenshot",
        "assertTrue",
        "assertVar",
        "assertVisible",
        "await",
        "back",
        "backgroundApp",
        "buildGif",
        "captureFrame",
        "captureGifFrame",
        "checkColor",
        "checkDevice",
        "clear",
        "clearAppData",
        "click",
        "conditional",
        "contextClick",
        "copyTextFrom",
        "createGif",
        "dbQuery",
        "deepLink",
        "display",
        "doubleTap",
        "doubleTapOn",
        "drag",
        "dragFromTo",
        "eraseText",
        "evalScript",
        "execPython",
        "exportReport",
        "extendedWaitUntil",
        "find",
        "focusApp",
        "forEach",
        "for_each",
        "foreach",
        "generate",
        "getClipboard",
        "getDeviceState",
        "gps",
        "hideKbd",
        "hideKeyboard",
        "home",
        "httpRequest",
        "hwAddCctPoint",
        "hwCalibrateBrightness",
        "hwCalibrateColor",
        "hwClick",
        "hwConfigureServo",
        "hwConnect",
        "hwDiagnostics",
        "hwDisconnect",
        "hwPing",
        "hwEraseCalibration",
        "hwLoadCalibration",
        "hwPowerCycle",
        "hwPowerOff",
        "hwPowerOffAll",
        "hwPowerOn",
        "hwPress",
        "hwReadColor",
        "hwReadRelay",
        "hwReadSensorLight",
        "hwReadServo",
        "hwRelease",
        "hwReleaseAll",
        "hwRepeatClick",
        "hwResetCalibration",
        "hwRotate",
        "hwSafeState",
        "hwSaveCalibration",
        "hwSeeLed",
        "hwSeeLedBlink",
        "hwSeeNativeLedBlink",
        "hwSeeLedOff",
        "hwSensorLight",
        "hwSetBrightnessThresholds",
        "hwStartRepeatClick",
        "hwStopRepeatClick",
        "hwWaitForBrightness",
        "hwWaitForCct",
        "inputAt",
        "inputRandomEmail",
        "inputRandomNumber",
        "inputRandomPersonName",
        "inputRandomPhoneNumber",
        "inputRandomText",
        "inputText",
        "installApp",
        "lark",
        "launchApp",
        "locale",
        "lockDevice",
        "longPress",
        "longPressOn",
        "match",
        "mockLocation",
        "mockLocationControl",
        "navigate",
        "notSee",
        "open",
        "openLink",
        "openNotifications",
        "openQuickSettings",
        "pasteText",
        "pinch",
        "playMedia",
        "press",
        "pressHome",
        "pressKey",
        "pullFile",
        "pushFile",
        "python",
        "repeat",
        "resizeWindow",
        "retry",
        "rightClick",
        "rotate",
        "rotateScreen",
        "runFlow",
        "hcHealth",
        "hcGetEntities",
        "hcGetState",
        "hcControl",
        "hcWaitState",
        "wsSubscribe",
        "wsExpect",
        "wsSnapshot",
        "runPython",
        "runScript",
        "screenshot",
        "scrollTo",
        "scrollUntilVisible",
        "see",
        "selectDisplay",
        "sendLarkMessage",
        "sendlarkmessage",
        "setClipboard",
        "setCpuThrottling",
        "setLocale",
        "setNetwork",
        "setNetworkConditions",
        "setOrientation",
        "setVar",
        "setWindow",
        "setWindowSize",
        "setVolume",
        "shove",
        "snapshot",
        "startAudioCapture",
        "startGifCapture",
        "startProfiling",
        "startRecording",
        "stop",
        "stopApp",
        "stopAudioCapture",
        "stopGifCapture",
        "stopGps",
        "stopMedia",
        "stopMockLocation",
        "stopProfiling",
        "stopRecord",
        "stopRecording",
        "swipe",
        "switchApp",
        "swipeDown",
        "swipeLeft",
        "swipeRight",
        "swipeUp",
        "takeScreenshot",
        "takeSnapshot",
        "tap",
        "tapAt",
        "tapOn",
        "toggleAirplaneMode",
        "type",
        "uninstallApp",
        "unlockDevice",
        "verifyAudioDucking",
        "wait",
        "waitDeviceState",
        "waitForAnimationToEnd",
        "waitForLocation",
        "waitForMockCompletion",
        "waitLedPattern",
        "waitNotSee",
        "waitSee",
        "when",
        "waitUntilNotVisible",
        "waitUntilVisible",
        "windowSize",
        "write"
      ]
    },
    "command": {
      "oneOf": [
        {
          "$ref": "#/$defs/commandName"
        },
        {
          "type": "object",
          "required": ["runFlow"],
          "additionalProperties": false,
          "properties": {
            "runFlow": {
              "$ref": "#/$defs/runFlow"
            }
          }
        },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "not": {
            "required": ["runFlow"]
          },
          "propertyNames": {
            "$ref": "#/$defs/commandName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/commandParams"
          }
        }
      ]
    },
    "commandParams": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/selector"
        },
        {
          "$ref": "#/$defs/commandArray"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        }
      ]
    },
    "commandArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "value": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      ]
    },
    "selector": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "label": {
          "type": "string"
        },
        "element": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "regex": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "resourceId": {
          "type": "string"
        },
        "desc": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "contentDesc": {
          "type": "string"
        },
        "accessibilityId": {
          "type": "string"
        },
        "css": {
          "type": "string"
        },
        "xpath": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "placeholder": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "elementType": {
          "type": "string"
        },
        "point": {
          "type": "string"
        },
        "align": {
          "type": "string",
          "enum": [
            "left",
            "right",
            "top",
            "bottom",
            "center"
          ]
        },
        "offset": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "exact": {
          "type": "boolean"
        },
        "optional": {
          "type": "boolean"
        },
        "when": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ]
        },
        "timeout": {
          "type": "integer",
          "minimum": 0
        },
        "soft": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "imageRegion": {
          "type": "string"
        },
        "ocr": {
          "$ref": "#/$defs/ocrSelector"
        },
        "relative": {
          "$ref": "#/$defs/relativeSelector"
        },
        "rightOf": {
          "$ref": "#/$defs/anchor"
        },
        "leftOf": {
          "$ref": "#/$defs/anchor"
        },
        "above": {
          "$ref": "#/$defs/anchor"
        },
        "below": {
          "$ref": "#/$defs/anchor"
        },
        "scrollable": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enable": {
                  "type": "boolean"
                },
                "index": {
                  "type": "integer",
                  "minimum": 0
                },
                "itemIndex": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": true
            }
          ]
        },
        "containsChild": {
          "$ref": "#/$defs/selector"
        },
        "contains_child": {
          "$ref": "#/$defs/selector"
        },
        "commands": {
          "$ref": "#/$defs/commandArray"
        },
        "then": {
          "$ref": "#/$defs/commandArray"
        },
        "else": {
          "$ref": "#/$defs/commandArray"
        }
      }
    },
    "ocrSelector": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "region": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "relativeSelector": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "rightOf": {
          "$ref": "#/$defs/anchor"
        },
        "leftOf": {
          "$ref": "#/$defs/anchor"
        },
        "above": {
          "$ref": "#/$defs/anchor"
        },
        "below": {
          "$ref": "#/$defs/anchor"
        },
        "maxDist": {
          "type": "integer",
          "minimum": 0
        },
        "maxDistance": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "anchor": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "element": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "regex": {
              "type": "string"
            },
            "textRegex": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "resourceId": {
              "type": "string"
            },
            "desc": {
              "type": "string"
            },
            "contentDesc": {
              "type": "string"
            },
            "accessibilityId": {
              "type": "string"
            },
            "css": {
              "type": "string"
            },
            "xpath": {
              "type": "string"
            },
            "placeholder": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "image": {
              "type": "string"
            },
            "exact": {
              "type": "boolean"
            },
            "index": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "colorName": {
      "type": "string",
      "enum": [
        "RED",
        "GREEN",
        "BLUE",
        "YELLOW",
        "CYAN",
        "MAGENTA",
        "PINK",
        "WHITE",
        "OFF"
      ]
    },
    "runPythonParams": {
      "type": "object",
      "properties": {
        "script": {
          "type": "string",
          "description": "Path to Python script file (.py) relative to flow directory"
        },
        "code": {
          "type": "string",
          "description": "Inline Python code snippet to execute"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Command line arguments passed to Python script"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Environment variables passed to Python process"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum execution timeout in milliseconds (default: 30000)"
        },
        "pythonPath": {
          "type": "string",
          "description": "Custom Python binary path (e.g., 'python3', 'python', or venv path)"
        },
        "saveVar": {
          "type": "string",
          "description": "Variable name to save trimmed stdout text output"
        },
        "saveVars": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "List of JSON keys to extract into variables from Python JSON stdout"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Map of varName -> jsonPath to extract into variables from Python JSON stdout"
            }
          ],
          "description": "Extract multiple variables from Python JSON stdout"
        }
      },
      "additionalProperties": true
    }
  }
}
